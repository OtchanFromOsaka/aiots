#!/bin/bash

start_time=`date +%s`

if [ $# -ne 1 ]; then
  echo "please add option \"setup\" or \"update\"."
  exit 1
fi

if [ $1 != "setup" ] && [ $1 != "update" ]; then
  echo "please add option \"setup\" or \"update\"."
  exit 1
fi

if [ $1 = "setup" ]; then
  apt-get update -y
  apt-get install -y curl
  apt-get install -y npm
  npm install -g pnpm
  npm install -g n
  npm install -g @playwright/test
  n 22
  pnpm exec playwright install-deps
  chown -R aiots:aiots /home/aiots/dev
  chown -R aiots:aiots /usr/local/bin/aiots
  chmod 744 /sbin/root
  chmod 744 /usr/local/bin/aiots
fi

if [ $1 = "update" ]; then
  apt-get update -y
  apt-get upgrade -y
  apt-get full-upgrade -y
  apt-get autoremove -y
  apt-get autoclean -y
  npm install -g pnpm
  npm install -g n
  npm install -g @playwright/test
  n 22
  pnpm exec playwright install-deps
  chown -R aiots:aiots /home/aiots/dev
  chown -R aiots:aiots /usr/local/bin/aiots
  chmod 744 /sbin/root
  chmod 744 /usr/local/bin/aiots
fi

end_time=`date +%s`
time=$((end_time - start_time))
echo "Done in $time sec"
